---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { getMockOrder } from '@/lib/mock-orders';
import { formatINR, getPlan } from '@/lib/plans';
import '@/styles/global.css';
const orderId = Astro.url.searchParams.get('order_id') ?? '';
const order = getMockOrder(orderId);
const plan = getPlan(order?.planId);
const user = Astro.locals.user;
---
<Base title="Recovery Portal | HackedWebsiteRecovery.com" description="Track your simulated recovery order and next required action." noindex={true}>
  <Nav />
  <main class="bg-slate-50 px-4 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10"><p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-600">Customer portal · demo</p><h1 class="text-4xl font-extrabold tracking-tight text-slate-900">Your recovery workspace.</h1><p class="mt-4 max-w-2xl text-lg text-slate-600">This simulated paid order shows the safe customer-facing status model planned for the production portal.</p></div>
      {user ? <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-6"><div><p class="text-sm text-slate-500">Signed in as</p><p class="font-semibold text-slate-900">{user.email}</p></div><form method="post" action="/api/auth/sign-out"><button class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700 hover:border-slate-500" type="submit">Sign out</button></form></div><div id="customer-cases" class="mt-7 space-y-5"><p class="text-sm text-slate-500">Loading your cases…</p></div></div> : !order || !plan ? <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-relaxed text-amber-950">This demo order is unavailable. Start again from <a class="font-semibold underline" href="/compare/">plan comparison</a>.</div> : <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-100 pb-6"><div><div class="text-sm font-semibold text-blue-600">{plan.eyebrow}</div><h2 class="text-2xl font-bold text-slate-900">{plan.name}</h2></div><span class="rounded-full bg-green-100 px-3 py-1 text-xs font-bold text-green-700">{order.status === 'onboarding_complete' ? 'ONBOARDING COMPLETE' : 'PAID'}</span></div><dl class="mt-6 grid gap-5 text-sm sm:grid-cols-2"><div><dt class="text-slate-500">Order reference</dt><dd class="mt-1 break-all font-mono font-semibold text-slate-900">{order.id}</dd></div><div><dt class="text-slate-500">Amount paid</dt><dd class="mt-1 font-semibold text-slate-900">{formatINR(order.totalPaise)} incl. GST</dd></div><div><dt class="text-slate-500">Payment status</dt><dd class="mt-1 font-semibold text-green-700">Confirmed (simulated)</dd></div><div><dt class="text-slate-500">Next action</dt><dd class="mt-1 font-semibold text-slate-900">Secure access checklist</dd></div></dl><div class="mt-8 border-t border-slate-100 pt-7"><h3 class="mb-4 text-lg font-bold text-slate-900">Case timeline</h3><ol class="space-y-4 text-sm"><li class="flex gap-3"><span class="mt-1 h-3 w-3 rounded-full bg-green-500 ring-4 ring-green-100"></span><div><strong class="text-slate-900">Payment confirmed</strong><p class="text-slate-600">Your order is recorded and ready for onboarding.</p></div></li><li class="flex gap-3"><span class="mt-1 h-3 w-3 rounded-full bg-blue-500 ring-4 ring-blue-100"></span><div><strong class="text-slate-900">Awaiting access</strong><p class="text-slate-600">In production, you will submit temporary access through the secure portal.</p></div></li><li class="flex gap-3"><span class="mt-1 h-3 w-3 rounded-full bg-slate-300 ring-4 ring-slate-100"></span><div><strong class="text-slate-500">Assessment after usable access</strong><p class="text-slate-500">We confirm scope and estimated completion time after assessment.</p></div></li></ol></div></section>
        <aside class="h-fit rounded-2xl bg-slate-950 p-6 text-white"><h2 class="text-xl font-bold">What happens next</h2><p class="mt-3 text-sm leading-relaxed text-slate-400">The production portal will guide you through structured temporary access, approvals, customer-safe updates, and report downloads.</p><a href={`/onboarding/?order_id=${encodeURIComponent(orderId)}`} class="mt-7 inline-flex w-full justify-center rounded-xl bg-blue-500 px-5 py-3 text-sm font-bold hover:bg-blue-400">Review onboarding checklist</a><div class="mt-6 border-t border-slate-800 pt-6 text-xs leading-relaxed text-slate-400"><strong class="text-slate-200">Response clock:</strong> the four-hour, 24/7 first-response deadline starts after payment is confirmed and usable access is received.</div></aside>
      </div>}
    </div>
  </main>
  <Footer />
</Base>

{user ? <script>
  const container = document.querySelector('#customer-cases');
  fetch('/api/customer/cases', { headers: { Accept: 'application/json' } }).then(async (response) => {
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'Cases could not be loaded.');
    if (!result.cases?.length) { if (container) container.textContent = 'No recovery cases are attached to this account yet.'; return; }
    if (container) {
      container.textContent = '';
      for (const item of result.cases) {
        const card = document.createElement('article'); card.className = 'rounded-xl border border-slate-200 p-5';
        const heading = document.createElement('h2'); heading.className = 'text-lg font-bold text-slate-900'; heading.textContent = `Case ${item.id}`;
        const status = document.createElement('p'); status.className = 'mt-1 text-sm font-semibold text-blue-700'; status.textContent = item.status.replaceAll('_', ' ');
        const timeline = document.createElement('p'); timeline.className = 'mt-4 text-sm text-slate-600'; timeline.textContent = item.responseDeadlineAt ? `First response deadline: ${new Date(item.responseDeadlineAt).toLocaleString()}` : 'Response clock starts after verified payment and usable access.';
        const link = document.createElement('a'); link.className = 'mt-4 inline-block text-sm font-semibold text-blue-700'; link.href = `/portal/cases/${encodeURIComponent(item.id)}`; link.textContent = 'View timeline and reports →';
        card.append(heading, status, timeline, link); container.append(card);
      }
    }
  }).catch((error) => { if (container) { container.textContent = error instanceof Error ? error.message : 'Cases could not be loaded.'; } });
</script> : null}

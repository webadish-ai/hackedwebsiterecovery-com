---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import StickyCTA from '@/components/StickyCTA.astro';
import ScannerCTA from '@/components/ScannerCTA.astro';
import '@/styles/global.css';

const faqs = [
  {
    q: 'How long does it take to remove a Google blacklist warning?',
    a: 'Once your site is fully clean, we submit a reconsideration request to Google Search Console. Google typically reviews and clears the "This site may be hacked" or "Deceptive site ahead" warning within 1–3 days. The cleanup itself usually takes 4–12 hours. In a recent eCommerce recovery we handled, the Google warning was cleared within 48 hours of starting work.',
  },
  {
    q: 'What does the "This site may be hacked" warning mean?',
    a: 'It means Google Safe Browsing detected hacked content, malware, or injected spam pages on your domain. Google adds a warning label in search results and Chrome may show a red interstitial page before visitors can reach your site. It is a strong signal that your WordPress site is compromised and needs cleaning — not just a cosmetic Google issue.',
  },
  {
    q: 'Can you remove "Deceptive site ahead" and "Dangerous site" warnings too?',
    a: 'Yes. "Deceptive site ahead", "Dangerous site", "The site ahead contains malware", and "This site may be hacked" are all Google Safe Browsing flags. The fix is the same: remove the malicious content and entry point causing the flag, then request a review. We handle the full process including the Search Console submission.',
  },
  {
    q: 'Will I lose my Google rankings because of the blacklist?',
    a: 'A blacklist causes a sharp traffic drop while the warning is live, because users see a warning before they reach your site and Google may suppress flagged pages. Once the site is cleaned and the warning is cleared, rankings typically begin recovering. Acting fast limits the SEO damage — the longer a site stays flagged, the longer recovery takes.',
  },
  {
    q: 'Do I need access to my Google Search Console?',
    a: 'It helps. If you already have Search Console set up, we use it to submit the reconsideration request directly. If you do not, we can guide you through verifying ownership (a 5-minute step), or submit through the available channels. We also need hosting/cPanel access to clean the underlying malware causing the flag.',
  },
  {
    q: 'What does Google blacklist removal cost in India?',
    a: 'Blacklist removal is included as part of our malware cleanup, which starts at ₹14,999 for standard WordPress sites. The price covers the full cleanup, hardening, and the Google reconsideration request. The diagnosis is free and you get a fixed quote before any work starts. WooCommerce and complex sites are quoted individually.',
  },
];

const warnings = [
  { label: 'This site may be hacked', desc: 'Shown under your listing in Google search results — warns users your pages were compromised.' },
  { label: 'Deceptive site ahead', desc: 'Full-page red warning in Chrome before the visitor can reach your site. Most traffic turns back here.' },
  { label: 'The site ahead contains malware', desc: 'Google Safe Browsing detected malware being served to visitors from your domain.' },
  { label: 'Dangerous site / Phishing', desc: 'Your domain is being used (often without your knowledge) to host phishing or attack pages.' },
];
---

<Base
  title="Google Blacklist Removal India | Fix Site Hacked Warning"
  description="Remove the Google 'This site may be hacked' or 'Deceptive site ahead' warning. Full WordPress malware cleanup plus Search Console reconsideration. Free diagnosis, fixed price from ₹14,999."
  canonical="https://www.wordpressrecovery.in/google-blacklist-removal-india/"
>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Google Blacklist Removal India",
    "description": "Remove Google Safe Browsing warnings (This site may be hacked / Deceptive site ahead) from WordPress sites. Includes malware cleanup, hardening, and Search Console reconsideration request.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "WordPressRecovery.in",
      "url": "https://www.wordpressrecovery.in",
      "telephone": "+919998757045"
    },
    "areaServed": { "@type": "Country", "name": "India" },
    "offers": {
      "@type": "Offer",
      "price": "14999",
      "priceCurrency": "INR",
      "description": "Starting price including malware cleanup and Google blacklist reconsideration"
    },
    "serviceType": "Google Blacklist Removal"
  })} />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <Nav />

  <!-- Hero -->
  <section class="gradient-hero text-white pt-20 pb-24 px-4 relative overflow-hidden" id="top">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 40px 40px;" aria-hidden="true"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-blue-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto text-center relative">
      <div class="inline-flex items-center gap-2 bg-red-500/15 border border-red-500/30 text-red-400 text-sm font-semibold px-4 py-2 rounded-full mb-8">
        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse-slow inline-block"></span>
        Google Blacklist Removal — India
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight mb-6 tracking-tight">
        Google Says Your Site<br>
        <span class="text-blue-400">"May Be Hacked"?</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        We remove the malware causing the warning, then submit the Google reconsideration request to clear it — fast. Most warnings are cleared within 1–3 days of cleanup. Fixed price. Free diagnosis.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-14">
        <a href="#contact" class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200 shadow-lg shadow-blue-700/30">
          Get Free Diagnosis
        </a>
        <a href="https://wa.me/919998757045?text=Google%20is%20showing%20a%20hacked%20warning%20on%20my%20site.%20I%20need%20it%20removed." target="_blank" rel="noopener noreferrer" onclick="window.trackWhatsAppClick?.()" class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200">
          WhatsApp Now
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-3 text-sm text-slate-400">
        {['Warning cleared in 1–3 days', 'Reconsideration request handled', 'Backup before any changes', 'Same-day cleanup available'].map(item => (
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/10 rounded-full px-3 py-1">
            <svg class="w-3.5 h-3.5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Which warning -->
  <section class="py-20 px-4 bg-slate-900">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Which Google Warning Are You Seeing?</h2>
        <p class="text-slate-400 max-w-xl mx-auto">All of these come from Google Safe Browsing and mean the same thing — your WordPress site is serving hacked or malicious content. We remove all of them.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {warnings.map(w => (
          <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-5 flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-red-500/15 border border-red-500/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <div>
              <div class="font-semibold text-white mb-1">&ldquo;{w.label}&rdquo;</div>
              <p class="text-slate-400 text-sm leading-relaxed">{w.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Real result proof -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gray-50 border border-gray-200 rounded-3xl p-8 sm:p-10">
        <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-5">Real client recovery</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4 leading-tight">Hacked eCommerce site — Google warning cleared in 48 hours</h2>
        <p class="text-gray-600 leading-relaxed mb-8">
          A WebAdish client (Verofax) came to us after their site started redirecting visitors to spam and Google flagged it. Earlier plugin-based cleanups had failed and the infection kept returning. We ran a full forensic cleanup, removed multiple hidden backdoors, hardened the entry point, and submitted the reconsideration request.
        </p>
        <div class="grid grid-cols-3 gap-4 mb-8">
          {[
            { value: '<48h', label: 'Full recovery' },
            { value: '48h', label: 'Google warning cleared' },
            { value: '0', label: 'Reinfections in 30 days' },
          ].map(m => (
            <div class="bg-green-50 border border-green-100 rounded-2xl py-5 text-center">
              <div class="text-2xl font-extrabold text-green-700 leading-none">{m.value}</div>
              <div class="text-[11px] font-medium uppercase tracking-wide text-green-600 mt-1.5">{m.label}</div>
            </div>
          ))}
        </div>
        <a href="https://webadish.com/case-studies/verofax" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:gap-2.5 transition-all">
          Read the full case study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 px-4 bg-slate-950">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How We Clear the Google Warning</h2>
        <p class="text-slate-400">Removing the warning without removing the cause just gets you re-flagged. We do both.</p>
      </div>
      <div class="space-y-4">
        {[
          { step: '1', title: 'Free Diagnosis', desc: 'We confirm the Safe Browsing flag, identify the hacked content Google detected, and scope the infection. You get a fixed quote before any work begins.' },
          { step: '2', title: 'Backup & Clean', desc: 'Full backup taken first. Then a server-level scan removes all malware, injected spam pages, and hidden backdoors causing the flag.' },
          { step: '3', title: 'Close the Entry Point', desc: 'We harden the specific vulnerability the attacker used and reset credentials — so Google does not re-flag the site days later.' },
          { step: '4', title: 'Submit Reconsideration', desc: 'We verify the site is clean in Google Search Console and submit the Security Issues reconsideration request on your behalf.' },
          { step: '5', title: 'Warning Cleared', desc: 'Google reviews and removes the warning, typically within 1–3 days. We confirm with you once it is lifted and traffic can flow again.' },
        ].map(s => (
          <div class="flex gap-5 items-start bg-slate-900/60 border border-slate-800 rounded-xl p-5">
            <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold text-sm">{s.step}</div>
            <div>
              <div class="font-semibold text-white mb-1">{s.title}</div>
              <p class="text-slate-400 text-sm leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ScannerCTA />

  <!-- Pricing -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Blacklist Removal Pricing (India)</h2>
      <p class="text-gray-600 mb-12">Blacklist removal is included in the malware cleanup — one fixed fee, no surprises.</p>

      <div class="grid sm:grid-cols-2 gap-5 mb-8">
        <div class="border-2 border-blue-600 rounded-2xl p-7 text-left shadow-xl shadow-blue-100 relative">
          <div class="absolute -top-3.5 left-6 bg-blue-600 text-white text-xs font-bold px-4 py-1 rounded-full">MOST COMMON</div>
          <div class="text-sm font-semibold text-blue-600 mb-2">Cleanup + Blacklist Removal</div>
          <div class="text-4xl font-extrabold text-slate-900 mb-1">₹14,999<span class="text-xl font-normal text-gray-400">+</span></div>
          <div class="text-xs text-gray-400 mb-5">Standard WordPress sites</div>
          <ul class="space-y-2 text-sm text-gray-700">
            {['Full server & database scan', 'Malware & backdoor removal', 'Injected spam page cleanup', 'Entry point hardening', 'Search Console reconsideration request', 'Cleanup report'].map(f => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {f}
              </li>
            ))}
          </ul>
        </div>

        <div class="border border-gray-200 rounded-2xl p-7 text-left">
          <div class="text-sm font-semibold text-gray-500 mb-2">WooCommerce / Complex</div>
          <div class="text-4xl font-extrabold text-slate-900 mb-1">₹75,000<span class="text-xl font-normal text-gray-400">+</span></div>
          <div class="text-xs text-gray-400 mb-5">Stores, lead-heavy & multi-site</div>
          <ul class="space-y-2 text-sm text-gray-700">
            {['Everything in standard cleanup', 'WooCommerce data integrity check', 'Payment gateway verification', 'Extended root cause investigation', 'Priority same-day handling'].map(f => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-sm text-gray-400">All prices are starting points. Exact quote provided after free diagnosis. UPI and bank transfer accepted.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 px-4 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Google Blacklist Removal — FAQ</h2>
        <p class="text-gray-600">Common questions about clearing a Google Safe Browsing warning.</p>
      </div>
      <div class="space-y-2" id="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item bg-white border border-gray-200 rounded-xl overflow-hidden">
            <button class="faq-btn w-full text-left px-6 py-5 flex items-center justify-between gap-4 hover:bg-gray-50 transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-expanded="false">
              <span class="font-semibold text-slate-900 text-[15px]">{faq.q}</span>
              <svg class="faq-icon w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-280" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-body border-t border-gray-100">
              <div>
                <p class="px-6 py-4 text-gray-600 text-sm leading-relaxed">{faq.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Contact />
  <Footer />
  <StickyCTA />

</Base>

<script>
  import { initReveal } from '@/lib/reveal';
  initReveal();

  document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const body = item.querySelector<HTMLElement>('.faq-body')!;
      const icon = btn.querySelector<SVGElement>('.faq-icon')!;
      const isOpen = body.classList.contains('open');
      document.querySelectorAll<HTMLElement>('.faq-body').forEach(b => b.classList.remove('open'));
      document.querySelectorAll<SVGElement>('.faq-icon').forEach(ic => ic.style.transform = '');
      document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
      if (!isOpen) {
        body.classList.add('open');
        icon.style.transform = 'rotate(180deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

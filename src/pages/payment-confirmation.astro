---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
const orderId = Astro.url.searchParams.get('order_id') ?? '';
---
<Base title="Payment Confirmation | HackedWebsiteRecovery.com" description="Confirm your simulated recovery payment and continue to onboarding." noindex={true}>
  <Nav />
  <main class="bg-slate-950 px-4 py-20 text-white sm:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <div id="pending-state">
        <div class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full border border-blue-400/30 bg-blue-500/15"><svg class="h-9 w-9 animate-pulse text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" /></svg></div>
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-300">Payment confirmation</p>
        <h1 class="mb-5 text-4xl font-extrabold sm:text-5xl">Confirming your payment.</h1>
        <p class="text-lg leading-relaxed text-slate-300">This demo confirms the order through a mocked payment adapter. In production, this page will wait for reverse-hash and provider verification before fulfilment.</p>
        <button id="confirm-payment" class="mt-9 inline-flex items-center justify-center rounded-xl bg-blue-500 px-6 py-4 text-sm font-bold transition-colors hover:bg-blue-400">Simulate successful payment</button>
        <p id="payment-error" class="mx-auto mt-5 hidden max-w-md rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-200" role="alert"></p>
      </div>
      <div id="confirmed-state" class="hidden">
        <div class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full border border-green-400/30 bg-green-500/15"><svg class="h-10 w-10 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg></div>
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-green-300">Payment confirmed</p>
        <h1 class="mb-5 text-4xl font-extrabold sm:text-5xl">Your recovery order is ready.</h1>
        <p class="text-lg leading-relaxed text-slate-300">Keep this transaction reference for your records. Continue to the onboarding checklist so our team knows what is ready for the secure portal.</p>
        <div class="mx-auto mt-8 max-w-sm rounded-2xl border border-slate-700 bg-white/5 p-5 text-left text-sm"><div class="text-slate-400">Mock transaction</div><div id="transaction-id" class="mt-1 break-all font-mono font-semibold text-white"></div><div class="mt-4 text-slate-400">Order status</div><div class="mt-1 font-semibold text-green-300">Paid · awaiting onboarding</div></div>
        <a id="onboarding-link" href={`/onboarding/?order_id=${encodeURIComponent(orderId)}`} class="mt-9 inline-flex items-center justify-center rounded-xl bg-green-500 px-6 py-4 text-sm font-bold text-slate-950 transition-colors hover:bg-green-400">Continue to onboarding</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<script define:vars={{ orderId }}>
  const button = document.querySelector('#confirm-payment');
  const pending = document.querySelector('#pending-state');
  const confirmed = document.querySelector('#confirmed-state');
  const error = document.querySelector('#payment-error');
  const transaction = document.querySelector('#transaction-id');
  button?.addEventListener('click', async () => {
    button.disabled = true;
    button.textContent = 'Verifying simulated payment…';
    try {
      const response = await fetch('/api/payments/mock-confirm', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderId }) });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'This order is unavailable.');
      if (transaction) transaction.textContent = result.order.transactionId;
      pending?.classList.add('hidden');
      confirmed?.classList.remove('hidden');
      window.dispatchEvent(new CustomEvent('storefront_event', { detail: { event: 'payment_confirmed' } }));
      if (typeof window.gtag === 'function') window.gtag('event', 'payment_confirmed');
    } catch (err) {
      if (error) { error.textContent = err instanceof Error ? err.message : 'Payment could not be confirmed.'; error.classList.remove('hidden'); }
      button.disabled = false;
      button.textContent = 'Retry simulated payment';
    }
  });
</script>

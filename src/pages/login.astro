---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
const error = Astro.url.searchParams.get('error');
---
<Base title="Sign in | HackedWebsiteRecovery.com" description="Sign in to your recovery portal." noindex={true}>
  <Nav />
  <main class="bg-slate-50 px-4 py-20 sm:py-28">
    <div class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-7 shadow-sm sm:p-10">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-600">Recovery portal</p>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Sign in securely.</h1>
      <p class="mt-4 text-sm leading-relaxed text-slate-600">Enter the email used for your order. We will send a one-time magic link; no password is stored here.</p>
      {error ? <p class="mt-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="alert">That sign-in link is invalid or expired. Request a new one.</p> : null}
      <form id="magic-link-form" class="mt-7 space-y-4">
        <label class="block text-sm font-semibold text-slate-800" for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" placeholder="you@example.com" />
        <button class="w-full rounded-xl bg-blue-600 px-5 py-3.5 text-sm font-bold text-white hover:bg-blue-500" type="submit">Email me a sign-in link</button>
      </form>
      <p id="login-message" class="mt-5 hidden rounded-xl border px-4 py-3 text-sm" role="status"></p>
    </div>
  </main>
  <Footer />
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('#magic-link-form');
  const message = document.querySelector<HTMLParagraphElement>('#login-message');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button');
    if (button) { button.disabled = true; button.textContent = 'Sending…'; }
    try {
      const response = await fetch('/api/auth/magic-link', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: new FormData(form).get('email') }) });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Unable to send sign-in link.');
      if (message) { message.textContent = result.developmentToken ? `Development link token: ${result.developmentToken}` : (result.message || 'Check your email for a secure sign-in link.'); message.className = 'mt-5 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800'; }
    } catch (error) {
      if (message) { message.textContent = error instanceof Error ? error.message : 'Unable to send sign-in link.'; message.className = 'mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800'; }
    } finally { if (button) { button.disabled = false; button.textContent = 'Email me a sign-in link'; } }
  });
</script>

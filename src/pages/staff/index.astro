---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
const user = Astro.locals.user;
---
<Base title="Staff queue | HackedWebsiteRecovery.com" description="Internal recovery case queue." noindex={true}>
  <Nav />
  <main class="bg-slate-50 px-4 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-wrap items-start justify-between gap-5"><div><p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-600">Operations</p><h1 class="text-4xl font-extrabold tracking-tight text-slate-900">Response queue.</h1><p class="mt-3 text-slate-600">Cases are ordered by the four-hour deadline after payment and usable access.</p></div>{user ? <form method="post" action="/api/auth/sign-out"><button class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700" type="submit">Sign out</button></form> : null}</div>
      <section id="staff-queue" class="mt-10 space-y-4"><p class="rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Loading queue…</p></section>
    </div>
  </main>
  <Footer />
</Base>
<script>
  const queue = document.querySelector('#staff-queue');
  fetch('/api/staff/queue').then(async (response) => { const result = await response.json(); if (!response.ok) throw new Error(result.error || 'Queue unavailable.'); if (!result.cases?.length) { if (queue) queue.textContent = 'No cases are waiting for staff action.'; return; } if (queue) { queue.textContent = ''; for (const item of result.cases) { const card = document.createElement('a'); card.href = `/staff/cases/${encodeURIComponent(item.id)}`; card.className = 'block rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-blue-300'; const title = document.createElement('h2'); title.className = 'font-bold text-slate-900'; title.textContent = `Case ${item.id}`; const meta = document.createElement('p'); meta.className = 'mt-2 text-sm text-blue-700'; meta.textContent = item.responseDeadlineAt ? `${item.status.replaceAll('_', ' ')} · deadline ${new Date(item.responseDeadlineAt).toLocaleString()}` : `${item.status.replaceAll('_', ' ')} · access not ready`; card.append(title, meta); queue.append(card); } } }).catch((error) => { if (queue) queue.textContent = error instanceof Error ? error.message : 'Queue unavailable.'; });
</script>

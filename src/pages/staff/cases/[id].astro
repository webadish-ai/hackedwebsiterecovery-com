---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
const caseId = Astro.params.id ?? '';
---
<Base title="Staff case | HackedWebsiteRecovery.com" description="Internal recovery case details." noindex={true}>
  <Nav />
  <main class="bg-slate-50 px-4 py-16 sm:py-24"><div class="mx-auto max-w-3xl"><a href="/staff/" class="text-sm font-semibold text-blue-700">← Response queue</a><section id="staff-case" class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><p class="text-sm text-slate-500">Loading case…</p></section></div></main>
  <Footer />
</Base>
<script define:vars={{ caseId }}>
  const target = document.querySelector('#staff-case');
  fetch(`/api/staff/cases/${encodeURIComponent(caseId)}`).then(async (response) => { const result = await response.json(); if (!response.ok) throw new Error(result.error || 'Case unavailable.'); if (target) { target.textContent = ''; const heading = document.createElement('h1'); heading.className = 'text-2xl font-bold text-slate-900'; heading.textContent = `Case ${result.case.id}`; target.append(heading); const status = document.createElement('p'); status.className = 'mt-2 font-semibold text-blue-700'; status.textContent = result.case.status.replaceAll('_', ' '); target.append(status); const title = document.createElement('h2'); title.className = 'mt-8 text-lg font-bold text-slate-900'; title.textContent = 'Internal timeline'; target.append(title); for (const event of result.timeline ?? []) { const row = document.createElement('p'); row.className = 'mt-3 rounded-lg bg-slate-50 p-3 text-sm text-slate-700'; row.textContent = `${new Date(event.createdAt).toLocaleString()} · ${event.customerVisible ? 'Customer update' : 'Internal note'} · ${event.body}`; target.append(row); } } }).catch((error) => { if (target) target.textContent = error instanceof Error ? error.message : 'Case unavailable.'; });
</script>

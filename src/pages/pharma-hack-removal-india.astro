---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import StickyCTA from '@/components/StickyCTA.astro';
import ScannerCTA from '@/components/ScannerCTA.astro';
import '@/styles/global.css';

const faqs = [
  {
    q: 'What is the WordPress pharma hack?',
    a: 'The pharma hack injects spam content for Viagra, Cialis, and other pharmaceutical keywords into your WordPress site — hidden links, spam pages, and hijacked titles and meta descriptions. It is designed to exploit your site’s SEO authority to rank the attacker’s pharmacy spam, and it is one of the most common WordPress infections we clean.',
  },
  {
    q: 'Why do Viagra/Cialis keywords show in Google but not on my site?',
    a: 'The pharma hack uses cloaking: the malicious code detects Google’s crawler and serves it the spam content, while normal visitors see your regular pages. That is why your site looks fine in the browser but "site:yourdomain.com" searches show pill spam in titles and descriptions. Checking your pages by browsing them will never reveal it.',
  },
  {
    q: 'I cleaned the spam but it came back. Why?',
    a: 'Because the backdoor is still there. Pharma hack code hides in places surface scans miss — fake plugin files, the database (wp_options and post content), .htaccess rules, and encoded payloads inside legitimate-looking files. Unless every backdoor and the database payload are removed, the spam regenerates within days.',
  },
  {
    q: 'Will the pharma hack hurt my Google rankings?',
    a: 'Yes. Google may flag the site with "This site may be hacked" in results, your legitimate pages lose rankings to the injected spam, and visitors lose trust when they see pharmacy titles under your brand. The longer it stays, the deeper the damage — and the longer recovery of your real rankings takes after cleanup.',
  },
  {
    q: 'How do you remove the pharma hack?',
    a: 'We scan every file and the full database, remove the cloaking code, spam pages, hidden links, and every backdoor, then clean hijacked titles and metas. We request re-crawling of your real pages in Search Console and submit a reconsideration request if Google flagged the site. Finally we close the entry point so it cannot return. Most cleanups complete within 4–12 hours of access.',
  },
  {
    q: 'What does pharma hack removal cost in India?',
    a: 'It is part of our malware cleanup, starting at ₹14,999 for standard WordPress sites — including database cleanup, backdoor removal, Search Console re-crawl requests, and entry-point hardening. WooCommerce and complex sites are quoted individually. Diagnosis is free and you get a fixed quote before any work begins.',
  },
];

const signs = [
  { label: 'Pill spam in Google results', desc: 'Searching "site:yourdomain.com" shows Viagra, Cialis, or pharmacy keywords in your page titles and descriptions.' },
  { label: 'Site looks normal in the browser', desc: 'Cloaking serves spam only to Google’s crawler — you see your normal pages, Google sees a pharmacy.' },
  { label: 'Hidden links and spam pages', desc: 'Invisible links to online pharmacies injected into your content, or new spam URLs indexed under your domain.' },
  { label: '"This site may be hacked" warning', desc: 'Google adds the hacked-site label under your listing, and organic traffic starts dropping.' },
];
---

<Base
  title="Pharma Hack Removal India | Fix Viagra Spam on WordPress"
  description="Viagra or pharmacy keywords showing in Google for your WordPress site? We remove the cloaked pharma spam, database payloads, and every backdoor, then clean your Google results. Free diagnosis, fixed price from ₹14,999."
  canonical="https://www.wordpressrecovery.in/pharma-hack-removal-india/"
>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Pharma Hack Removal India",
    "description": "Removal of the WordPress pharma hack: deletes cloaked pharmaceutical spam, hidden links, database payloads, and backdoors, cleans hijacked titles and metas, and hardens the site against reinfection.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "WordPressRecovery.in",
      "url": "https://www.wordpressrecovery.in",
      "telephone": "+919998757045"
    },
    "areaServed": { "@type": "Country", "name": "India" },
    "offers": {
      "@type": "Offer",
      "price": "14999",
      "priceCurrency": "INR",
      "description": "Starting price for pharma hack removal"
    },
    "serviceType": "Pharma Hack Removal"
  })} />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <Nav />

  <!-- Hero -->
  <section class="gradient-hero text-white pt-20 pb-24 px-4 relative overflow-hidden" id="top">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 40px 40px;" aria-hidden="true"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-blue-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto text-center relative">
      <div class="inline-flex items-center gap-2 bg-red-500/15 border border-red-500/30 text-red-400 text-sm font-semibold px-4 py-2 rounded-full mb-8">
        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse-slow inline-block"></span>
        Pharma Hack Removal — India
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight mb-6 tracking-tight">
        Viagra Spam Showing<br>
        <span class="text-blue-400">in Your Google Results?</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        The pharma hack cloaks pharmacy spam inside your WordPress site — invisible to you, served to Google. We remove the cloaking code, database payloads, and every backdoor, then clean your search results — so it cannot return. Fixed price. Free diagnosis.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-14">
        <a href="#contact" class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200 shadow-lg shadow-blue-700/30">
          Get Free Diagnosis
        </a>
        <a href="https://wa.me/919998757045?text=My%20site%20has%20the%20pharma%20hack%20(Viagra%20spam%20in%20Google).%20I%20need%20it%20removed." target="_blank" rel="noopener noreferrer" onclick="window.trackWhatsAppClick?.()" class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200">
          WhatsApp Now
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-3 text-sm text-slate-400">
        {['Cloaked spam & backdoors removed', 'Database payloads cleaned', 'Google results restored', 'Same-day service available'].map(item => (
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/10 rounded-full px-3 py-1">
            <svg class="w-3.5 h-3.5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Signs -->
  <section class="py-20 px-4 bg-slate-900">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Signs of the Pharma Hack</h2>
        <p class="text-slate-400 max-w-2xl mx-auto">If you recognise any of these, your WordPress site has been compromised and is being used to host cloaked pharmacy spam.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {signs.map(w => (
          <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-5 flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-red-500/15 border border-red-500/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <div>
              <div class="font-semibold text-white mb-1">{w.label}</div>
              <p class="text-slate-400 text-sm leading-relaxed">{w.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Real result proof -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gray-50 border border-gray-200 rounded-3xl p-8 sm:p-10">
        <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-5">Real client recovery</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4 leading-tight">SEO-spam infection removed at the source — no return</h2>
        <p class="text-gray-600 leading-relaxed mb-8">
          A WebAdish client (Verofax) was hit with an infection that damaged their search presence and kept returning after surface cleanups, because hidden backdoors remained — the same mechanism that keeps pharma spam regenerating. We removed every backdoor, restored search integrity, and confirmed the site stayed clean with no reinfection.
        </p>
        <div class="grid grid-cols-3 gap-4 mb-8">
          {[
            { value: '<48h', label: 'Full recovery' },
            { value: '0', label: 'Reinfections in 30 days' },
            { value: '48h', label: 'Google warning cleared' },
          ].map(m => (
            <div class="bg-green-50 border border-green-100 rounded-2xl py-5 text-center">
              <div class="text-2xl font-extrabold text-green-700 leading-none">{m.value}</div>
              <div class="text-[11px] font-medium uppercase tracking-wide text-green-600 mt-1.5">{m.label}</div>
            </div>
          ))}
        </div>
        <a href="https://webadish.com/case-studies/verofax" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:gap-2.5 transition-all">
          Read the full case study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 px-4 bg-slate-950">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How We Remove It — For Good</h2>
        <p class="text-slate-400">Kill the cloaking, clean the database, close the door.</p>
      </div>
      <div class="space-y-4">
        {[
          { step: '1', title: 'Free Diagnosis', desc: 'We confirm the hack by crawling your site as Googlebot and checking "site:" results, then locate the cloaking code, database payloads, and backdoors. Fixed quote first.' },
          { step: '2', title: 'Backup & Remove Source', desc: 'Full backup taken, then we remove the cloaking scripts, spam pages, hidden links, and every backdoor from files and database.' },
          { step: '3', title: 'Clean Your Google Results', desc: 'Hijacked titles and metas are restored, spam URLs submitted for removal, and your real pages queued for re-crawling in Search Console.' },
          { step: '4', title: 'Harden the Entry Point', desc: 'The vulnerability used for access is closed and credentials reset, so the spam cannot regenerate.' },
          { step: '5', title: 'Handover & Report', desc: 'You receive a report of what was removed, plus the reconsideration request if Google flagged the site.' },
        ].map(s => (
          <div class="flex gap-5 items-start bg-slate-900/60 border border-slate-800 rounded-xl p-5">
            <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold text-sm">{s.step}</div>
            <div>
              <div class="font-semibold text-white mb-1">{s.title}</div>
              <p class="text-slate-400 text-sm leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ScannerCTA />

  <!-- Pricing -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Pharma Hack Removal Pricing (India)</h2>
      <p class="text-gray-600 mb-12">Fixed-fee pricing. You receive a quote after the free diagnosis — no surprises.</p>

      <div class="grid sm:grid-cols-2 gap-5 mb-8">
        <div class="border-2 border-blue-600 rounded-2xl p-7 text-left shadow-xl shadow-blue-100 relative">
          <div class="absolute -top-3.5 left-6 bg-blue-600 text-white text-xs font-bold px-4 py-1 rounded-full">MOST COMMON</div>
          <div class="text-sm font-semibold text-blue-600 mb-2">Pharma Spam Cleanup</div>
          <div class="text-4xl font-extrabold text-slate-900 mb-1">₹14,999<span class="text-xl font-normal text-gray-400">+</span></div>
          <div class="text-xs text-gray-400 mb-5">Standard WordPress sites</div>
          <ul class="space-y-2 text-sm text-gray-700">
            {['Cloaking & spam removal', 'Backdoor removal', 'Database payload cleanup', 'Titles & metas restored', 'Search Console re-crawl requests', 'Entry point hardening'].map(f => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {f}
              </li>
            ))}
          </ul>
        </div>

        <div class="border border-gray-200 rounded-2xl p-7 text-left">
          <div class="text-sm font-semibold text-gray-500 mb-2">WooCommerce / Complex</div>
          <div class="text-4xl font-extrabold text-slate-900 mb-1">₹75,000<span class="text-xl font-normal text-gray-400">+</span></div>
          <div class="text-xs text-gray-400 mb-5">Stores, lead-heavy & multi-site</div>
          <ul class="space-y-2 text-sm text-gray-700">
            {['Everything in standard cleanup', 'WooCommerce data integrity check', 'Payment gateway verification', 'Extended root cause investigation', 'Priority same-day handling'].map(f => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-sm text-gray-400">All prices are starting points. Exact quote provided after free diagnosis. UPI and bank transfer accepted.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 px-4 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Pharma Hack — FAQ</h2>
        <p class="text-gray-600">Common questions about the pharma (Viagra spam) hack on WordPress.</p>
      </div>
      <div class="space-y-2" id="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item bg-white border border-gray-200 rounded-xl overflow-hidden">
            <button class="faq-btn w-full text-left px-6 py-5 flex items-center justify-between gap-4 hover:bg-gray-50 transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-expanded="false">
              <span class="font-semibold text-slate-900 text-[15px]">{faq.q}</span>
              <svg class="faq-icon w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-280" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-body border-t border-gray-100">
              <div>
                <p class="px-6 py-4 text-gray-600 text-sm leading-relaxed">{faq.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Contact />
  <Footer />
  <StickyCTA />

</Base>

<script>
  import { initReveal } from '@/lib/reveal';
  initReveal();

  document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const body = item.querySelector<HTMLElement>('.faq-body')!;
      const icon = btn.querySelector<SVGElement>('.faq-icon')!;
      const isOpen = body.classList.contains('open');
      document.querySelectorAll<HTMLElement>('.faq-body').forEach(b => b.classList.remove('open'));
      document.querySelectorAll<SVGElement>('.faq-icon').forEach(ic => ic.style.transform = '');
      document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
      if (!isOpen) {
        body.classList.add('open');
        icon.style.transform = 'rotate(180deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

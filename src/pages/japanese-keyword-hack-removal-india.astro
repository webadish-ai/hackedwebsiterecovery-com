---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import StickyCTA from '@/components/StickyCTA.astro';
import ScannerCTA from '@/components/ScannerCTA.astro';
import '@/styles/global.css';

const faqs = [
  {
    q: 'What is the Japanese keyword hack?',
    a: 'The Japanese keyword hack (also called the "Japanese SEO spam" hack) injects thousands of auto-generated pages with Japanese text and links to fake stores into your WordPress site. Google indexes these pages under your domain, so your search results fill with Japanese spam titles. It is designed to hijack your site’s SEO authority to rank the attacker’s spam.',
  },
  {
    q: 'Why do Japanese pages show up in Google for my site?',
    a: 'The attacker has gained access — usually via a vulnerable plugin, theme, or stolen credentials — and added a script that generates spam pages and a sitemap pointing Google to them. They often add themselves as a Search Console owner to speed up indexing. The pages may not be visible when you browse your site normally, but they appear in "site:yourdomain.com" searches.',
  },
  {
    q: 'I keep deleting the spam pages but they come back. Why?',
    a: 'Because the backdoor and the generator script are still active and re-creating them. Deleting indexed pages without removing the source is why the hack persists. We remove the generator, every backdoor, the malicious sitemap, and any rogue Search Console owners, then harden the entry point so the pages cannot regenerate.',
  },
  {
    q: 'Will this hack hurt my Google rankings?',
    a: 'Yes — significantly if left unaddressed. Google may flag the site as hacked, your legitimate pages can lose rankings, and the spam pages waste your crawl budget. The faster it is cleaned and the spam pages are removed from the index, the faster your real rankings recover. We also handle the Search Console cleanup and reconsideration where needed.',
  },
  {
    q: 'How do you clean the Japanese keyword hack?',
    a: 'We locate and remove the spam-page generator and all backdoors, delete the injected pages and malicious sitemap, remove any unauthorised Search Console users, and submit the cleaned URLs for re-crawling. Then we harden the entry point. Most cleanups complete within 4–12 hours of access; heavily infected sites may take longer.',
  },
  {
    q: 'What does Japanese keyword hack removal cost in India?',
    a: 'It is part of our malware cleanup, starting at ₹14,999 for standard WordPress sites — including removal of the generator, backdoors, spam pages, and the Search Console cleanup. WooCommerce and complex sites are quoted individually. Diagnosis is free and you get a fixed quote before any work begins.',
  },
];

const signs = [
  { label: 'Japanese titles in Google', desc: 'Searching "site:yourdomain.com" shows hundreds or thousands of pages with Japanese spam titles and descriptions.' },
  { label: 'Unknown pages & sitemaps', desc: 'New URLs and an unfamiliar sitemap.xml you never created, pointing Google to the spam.' },
  { label: 'Rogue Search Console owner', desc: 'An unknown user added as a verified owner in Google Search Console to control indexing.' },
  { label: 'Spam returns after deletion', desc: 'Pages reappear within hours or days because a backdoor keeps regenerating them.' },
];
---

<Base
  title="Japanese Keyword Hack Removal India | Fix Japanese SEO Spam"
  description="Japanese spam pages showing in Google for your WordPress site? We remove the generator, backdoors, and injected pages, clean Search Console, and harden the site so it cannot return. Free diagnosis, fixed price from ₹14,999."
  canonical="https://www.wordpressrecovery.in/japanese-keyword-hack-removal-india/"
>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Japanese Keyword Hack Removal India",
    "description": "Removal of the Japanese keyword (Japanese SEO spam) hack from WordPress: deletes the spam-page generator, backdoors, injected pages, and malicious sitemap, cleans Google Search Console, and hardens the site.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "WordPressRecovery.in",
      "url": "https://www.wordpressrecovery.in",
      "telephone": "+919998757045"
    },
    "areaServed": { "@type": "Country", "name": "India" },
    "offers": {
      "@type": "Offer",
      "price": "14999",
      "priceCurrency": "INR",
      "description": "Starting price for Japanese keyword hack removal"
    },
    "serviceType": "Japanese Keyword Hack Removal"
  })} />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <Nav />

  <!-- Hero -->
  <section class="gradient-hero text-white pt-20 pb-24 px-4 relative overflow-hidden" id="top">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 40px 40px;" aria-hidden="true"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-blue-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto text-center relative">
      <div class="inline-flex items-center gap-2 bg-red-500/15 border border-red-500/30 text-red-400 text-sm font-semibold px-4 py-2 rounded-full mb-8">
        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse-slow inline-block"></span>
        Japanese Keyword Hack Removal — India
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight mb-6 tracking-tight">
        Japanese Spam Pages<br>
        <span class="text-blue-400">in Your Google Results?</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        The Japanese keyword hack floods your site with auto-generated spam pages to hijack your SEO. We remove the generator, every backdoor, the injected pages, and clean your Search Console — so it cannot regenerate. Fixed price. Free diagnosis.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-14">
        <a href="#contact" class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200 shadow-lg shadow-blue-700/30">
          Get Free Diagnosis
        </a>
        <a href="https://wa.me/919998757045?text=My%20site%20has%20the%20Japanese%20keyword%20hack.%20I%20need%20it%20removed." target="_blank" rel="noopener noreferrer" onclick="window.trackWhatsAppClick?.()" class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200">
          WhatsApp Now
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-3 text-sm text-slate-400">
        {['Generator & backdoors removed', 'Search Console cleaned', 'Spam pages de-indexed', 'Same-day service available'].map(item => (
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/10 rounded-full px-3 py-1">
            <svg class="w-3.5 h-3.5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Signs -->
  <section class="py-20 px-4 bg-slate-900">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Signs of the Japanese Keyword Hack</h2>
        <p class="text-slate-400 max-w-2xl mx-auto">If you recognise any of these, your WordPress site has been compromised and is being used to host SEO spam.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {signs.map(w => (
          <div class="bg-slate-800/60 border border-slate-700 rounded-xl p-5 flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-red-500/15 border border-red-500/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <div>
              <div class="font-semibold text-white mb-1">{w.label}</div>
              <p class="text-slate-400 text-sm leading-relaxed">{w.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Real result proof -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gray-50 border border-gray-200 rounded-3xl p-8 sm:p-10">
        <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-5">Real client recovery</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4 leading-tight">SEO-spam infection removed at the source — no return</h2>
        <p class="text-gray-600 leading-relaxed mb-8">
          A WebAdish client (Verofax) was hit with an infection that damaged their search presence and kept returning after surface cleanups, because hidden backdoors remained — the same mechanism that regenerates Japanese spam pages. We removed every backdoor, restored search integrity, and confirmed the site stayed clean with no reinfection.
        </p>
        <div class="grid grid-cols-3 gap-4 mb-8">
          {[
            { value: '<48h', label: 'Full recovery' },
            { value: '0', label: 'Reinfections in 30 days' },
            { value: '48h', label: 'Google warning cleared' },
          ].map(m => (
            <div class="bg-green-50 border border-green-100 rounded-2xl py-5 text-center">
              <div class="text-2xl font-extrabold text-green-700 leading-none">{m.value}</div>
              <div class="text-[11px] font-medium uppercase tracking-wide text-green-600 mt-1.5">{m.label}</div>
            </div>
          ))}
        </div>
        <a href="https://webadish.com/case-studies/verofax" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:gap-2.5 transition-all">
          Read the full case study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 px-4 bg-slate-950">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How We Remove It — For Good</h2>
        <p class="text-slate-400">Kill the generator, clean the index, close the door.</p>
      </div>
      <div class="space-y-4">
        {[
          { step: '1', title: 'Free Diagnosis', desc: 'We confirm the hack via Search Console and "site:" results, then locate the generator script, backdoors, and malicious sitemap. Fixed quote first.' },
          { step: '2', title: 'Backup & Remove Source', desc: 'Full backup taken, then we remove the spam-page generator, every backdoor, and the injected pages and sitemap.' },
          { step: '3', title: 'Clean Search Console', desc: 'We remove any unauthorised Search Console owners and submit the spam URLs for removal and re-crawling of your real pages.' },
          { step: '4', title: 'Harden the Entry Point', desc: 'The vulnerability used for access is closed and credentials reset, so the pages cannot regenerate.' },
          { step: '5', title: 'Handover & Report', desc: 'You receive a report of what was removed, plus the reconsideration request if Google flagged the site.' },
        ].map(s => (
          <div class="flex gap-5 items-start bg-slate-900/60 border border-slate-800 rounded-xl p-5">
            <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold text-sm">{s.step}</div>
            <div>
              <div class="font-semibold text-white mb-1">{s.title}</div>
              <p class="text-slate-400 text-sm leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ScannerCTA />

  <!-- Pricing -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Japanese Hack Removal Pricing (India)</h2>
      <p class="text-gray-600 mb-12">Fixed-fee pricing. You receive a quote after the free diagnosis — no surprises.</p>

      <div class="grid sm:grid-cols-2 gap-5 mb-8">
        <div class="border-2 border-blue-600 rounded-2xl p-7 text-left shadow-xl shadow-blue-100 relative">
          <div class="absolute -top-3.5 left-6 bg-blue-600 text-white text-xs font-bold px-4 py-1 rounded-full">MOST COMMON</div>
          <div class="text-sm font-semibold text-blue-600 mb-2">SEO Spam Cleanup</div>
          <div class="text-4xl font-extrabold text-slate-900 mb-1">₹14,999<span class="text-xl font-normal text-gray-400">+</span></div>
          <div class="text-xs text-gray-400 mb-5">Standard WordPress sites</div>
          <ul class="space-y-2 text-sm text-gray-700">
            {['Spam-page generator removal', 'Backdoor removal', 'Injected pages & sitemap cleanup', 'Search Console owner cleanup', 'Entry point hardening', 'Cleanup report'].map(f => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {f}
              </li>
            ))}
          </ul>
        </div>

        <div class="border border-gray-200 rounded-2xl p-7 text-left">
          <div class="text-sm font-semibold text-gray-500 mb-2">WooCommerce / Complex</div>
          <div class="text-4xl font-extrabold text-slate-900 mb-1">₹75,000<span class="text-xl font-normal text-gray-400">+</span></div>
          <div class="text-xs text-gray-400 mb-5">Stores, lead-heavy & multi-site</div>
          <ul class="space-y-2 text-sm text-gray-700">
            {['Everything in standard cleanup', 'WooCommerce data integrity check', 'Payment gateway verification', 'Extended root cause investigation', 'Priority same-day handling'].map(f => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-sm text-gray-400">All prices are starting points. Exact quote provided after free diagnosis. UPI and bank transfer accepted.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 px-4 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Japanese Keyword Hack — FAQ</h2>
        <p class="text-gray-600">Common questions about the Japanese SEO spam hack on WordPress.</p>
      </div>
      <div class="space-y-2" id="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item bg-white border border-gray-200 rounded-xl overflow-hidden">
            <button class="faq-btn w-full text-left px-6 py-5 flex items-center justify-between gap-4 hover:bg-gray-50 transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-expanded="false">
              <span class="font-semibold text-slate-900 text-[15px]">{faq.q}</span>
              <svg class="faq-icon w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-280" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-body border-t border-gray-100">
              <div>
                <p class="px-6 py-4 text-gray-600 text-sm leading-relaxed">{faq.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Contact />
  <Footer />
  <StickyCTA />

</Base>

<script>
  import { initReveal } from '@/lib/reveal';
  initReveal();

  document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const body = item.querySelector<HTMLElement>('.faq-body')!;
      const icon = btn.querySelector<SVGElement>('.faq-icon')!;
      const isOpen = body.classList.contains('open');
      document.querySelectorAll<HTMLElement>('.faq-body').forEach(b => b.classList.remove('open'));
      document.querySelectorAll<SVGElement>('.faq-icon').forEach(ic => ic.style.transform = '');
      document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
      if (!isOpen) {
        body.classList.add('open');
        icon.style.transform = 'rotate(180deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

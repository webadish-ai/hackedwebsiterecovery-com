---
// Persistent mobile action bar — emergency traffic is mostly on phones.
// Hidden on md+ (desktop has the nav CTAs always visible).
---
<div
  id="sticky-cta"
  class="md:hidden fixed bottom-0 inset-x-0 z-50 flex gap-2 p-3 bg-slate-950/95 backdrop-blur-md border-t border-slate-800 translate-y-full transition-transform duration-300"
  style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));"
>
  <a
    href="tel:+919998757045"
    onclick="window.trackPhoneClick?.()"
    class="flex-1 inline-flex items-center justify-center gap-2 bg-blue-600 active:bg-blue-700 text-white font-bold py-3.5 rounded-xl text-sm"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/></svg>
    Call Now
  </a>
  <a
    href="https://wa.me/919998757045?text=My%20WordPress%20website%20is%20hacked%2C%20I%20need%20emergency%20help."
    target="_blank"
    rel="noopener noreferrer"
    onclick="window.trackWhatsAppClick?.()"
    class="flex-1 inline-flex items-center justify-center gap-2 bg-green-600 active:bg-green-700 text-white font-bold py-3.5 rounded-xl text-sm"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
    WhatsApp
  </a>
</div>

<script>
  // Reveal after the user scrolls past the hero so it doesn't cover the first CTA.
  const bar = document.getElementById('sticky-cta');
  const show = () => bar?.classList.toggle('translate-y-full', window.scrollY < 600);
  window.addEventListener('scroll', show, { passive: true });
  show();
</script>

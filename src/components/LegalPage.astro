---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props { title: string; description: string; eyebrow: string; intro: string; sections: { heading: string; body: string }[]; }
const { title, description, eyebrow, intro, sections } = Astro.props;
---
<Base title={title} description={description} noindex={true}>
  <Nav />
  <main class="bg-slate-50 px-4 py-16 sm:py-24">
    <article class="mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-600">{eyebrow}</p>
      <h1 class="mb-5 text-4xl font-extrabold tracking-tight text-slate-900">{title}</h1>
      <p class="mb-10 text-lg leading-relaxed text-slate-600">{intro}</p>
      <div class="space-y-8">
        {sections.map((section) => <section><h2 class="mb-2 text-xl font-bold text-slate-900">{section.heading}</h2><p class="whitespace-pre-line text-sm leading-7 text-slate-600">{section.body}</p></section>)}
      </div>
      <p class="mt-10 border-t border-slate-100 pt-6 text-xs text-slate-500">Version 2026-09-05 · Questions: <a href="mailto:help@hackedwebsiterecovery.com" class="font-semibold text-blue-700">help@hackedwebsiterecovery.com</a></p>
    </article>
  </main>
  <Footer />
</Base>

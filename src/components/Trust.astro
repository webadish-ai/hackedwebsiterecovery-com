---
const credentials = [
  {
    title: '20+ Years IT Infrastructure',
    desc: 'Our senior cybersecurity expert has 20+ years in enterprise data centre management and information security — not just WordPress plugins.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>`,
  },
  {
    title: 'WordPress Recovery Specialists',
    desc: 'We focus exclusively on WordPress maintenance, security, and recovery. This is not a side service — it is what we do every day.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
  },
  {
    title: 'India-Focused Support',
    desc: 'Dedicated emergency support for Indian businesses. We understand local hosting providers, payment workflows, and the urgency of keeping business websites online.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>`,
  },
  {
    title: 'Backup Before Any Changes',
    desc: 'We always take a full backup before touching anything. Your data is protected regardless of what we find or how the recovery proceeds.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>`,
  },
  {
    title: 'Clear Scope & Quote First',
    desc: 'You receive a written scope of work and fixed price before we start. No surprise invoices. No vague "it depends" billing.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>`,
  },
  {
    title: 'Post-Recovery Hardening',
    desc: 'Every recovery includes hardening to close the entry point and reduce future risk. We fix the root cause, not just the symptoms.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>`,
  },
];

const stats = [
  { value: '20+', label: 'Years IT Experience' },
  { value: '20+', label: 'Years Web Design' },
  { value: 'India', label: 'Primary Market' },
  { value: 'DPIIT', label: 'Recognised Startup' },
];
---
<section class="py-20 px-4 bg-slate-900 text-white" id="about">
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-14" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">Why Trust Us With Your Website?</h2>
      <p class="text-slate-400 max-w-xl mx-auto">WordPressRecovery.in is the specialist emergency arm of WebAdish LLP — a DPIIT-recognised startup with a team that has recovered hundreds of websites.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {credentials.map((c, i) => (
        <div
          class="bg-slate-800 border border-slate-700 rounded-2xl p-6 hover:border-blue-600/50 hover:bg-slate-800/80 transition-all duration-200"
          data-reveal
          data-delay={String(Math.min((i % 3) * 100, 200))}
        >
          <div class="text-blue-400 mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <Fragment set:html={c.icon} />
            </svg>
          </div>
          <h3 class="font-bold text-white text-[15px] mb-2 leading-snug">{c.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>

    <!-- Stats -->
    <div class="mt-14 pt-10 border-t border-slate-700 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center" data-reveal>
      {stats.map((s) => (
        <div>
          <div
            class="text-3xl font-extrabold text-white"
            data-counter={s.value}
          >
            {s.value}
          </div>
          <div class="text-slate-400 text-sm mt-1">{s.label}</div>
        </div>
      ))}
    </div>

  </div>
</section>

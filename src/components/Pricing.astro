---
import { PLANS, formatINR } from '@/lib/plans';
---
<section class="py-20 px-4 bg-white" id="pricing">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-12" data-reveal>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-600">Choose your recovery path</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Clear plans. GST shown before payment.</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">Start with the plan that fits your site or agency. We assess scope after payment and contact you when usable access is received. Complex cases are quoted separately before work begins.</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      {PLANS.map((plan) => (
        <article class={`relative flex flex-col rounded-2xl p-6 transition-shadow duration-200 hover:shadow-lg ${plan.featured ? 'border-2 border-blue-600 shadow-xl shadow-blue-100' : 'border border-gray-200'}`} data-reveal>
          {plan.featured && <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-blue-600 px-4 py-1 text-xs font-bold text-white">MOST REQUESTED</div>}
          <div class="mb-2 text-sm font-semibold text-blue-600">{plan.eyebrow}</div>
          <h3 class="mb-2 text-2xl font-extrabold text-slate-900">{plan.name}</h3>
          <p class="mb-5 min-h-12 text-sm leading-relaxed text-gray-600">{plan.description}</p>
          <div class="mb-1 text-3xl font-extrabold text-slate-900">{formatINR(plan.pricePaise)}</div>
          <div class="mb-5 text-xs font-medium text-gray-500">{plan.billingLabel} · before 18% GST</div>
          <div class="mb-5 rounded-xl bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800">{plan.siteAllowance}</div>
          <ul class="mb-6 space-y-2 text-sm text-gray-600">
            {plan.inclusions.map((item) => <li class="flex gap-2"><span class="text-green-600" aria-hidden="true">✓</span><span>{item}</span></li>)}
          </ul>
          <a href={`/cart/?plan=${plan.id}`} data-plan-id={plan.id} class={`mt-auto inline-flex items-center justify-center rounded-xl px-5 py-3 text-center text-sm font-bold transition-colors duration-200 ${plan.featured ? 'bg-blue-600 text-white hover:bg-blue-500' : 'border border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100'}`}>
            {plan.actionLabel}
          </a>
          <a href={`/compare/#${plan.id}`} class="mt-3 text-center text-xs font-semibold text-gray-500 hover:text-blue-600">See full inclusions and exclusions</a>
        </article>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-center text-sm leading-relaxed text-amber-900">
      Multisite, hosting-account compromise, cross-site infection, missing-data restoration, custom applications, and complex WooCommerce cases require a separate quote. If unsupported paid work has not started, we offer an approved quote or a full refund.
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-plan-id]').forEach((card) => {
    card.addEventListener('click', () => {
      const eventName = 'select_plan';
      window.dispatchEvent(new CustomEvent('storefront_event', { detail: { event: eventName } }));
      if (typeof window.gtag === 'function') window.gtag('event', eventName);
    });
  });
</script>

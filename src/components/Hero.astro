---
---
<section class="gradient-hero text-white pt-20 pb-24 px-4 relative overflow-hidden" id="top">
  <!-- Subtle grid texture -->
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 40px 40px;"
    aria-hidden="true"
  ></div>

  <!-- Glow blob -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-blue-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-4xl mx-auto text-center relative">
    <div class="mb-7 flex justify-center" data-reveal>
      <div class="inline-flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-left">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Specialist service by</span>
        <img src="/brand/webadish-logo-white.png" alt="WebAdish LLP" class="h-7 w-auto" />
      </div>
    </div>

    <!-- Emergency badge -->
    <div class="inline-flex items-center gap-2 bg-red-500/15 border border-red-500/30 text-red-400 text-sm font-semibold px-4 py-2 rounded-full mb-8" data-reveal data-delay="100">
      <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse-slow inline-block"></span>
      24/7 Emergency WordPress Recovery Service
    </div>

    <!-- H1 -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight mb-6 tracking-tight" data-reveal data-delay="200">
      Your WordPress Site Is Hacked.<br>
      <span class="text-blue-400">We Can Fix It Today.</span>
    </h1>

    <p class="text-lg sm:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed" data-reveal data-delay="300">
      Redirecting to spam? Google warning? Hosting suspended? Admin locked out? Expert malware removal and full recovery from specialists with 20+ years of cybersecurity infrastructure experience.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-14" data-reveal data-delay="400">
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200 shadow-lg shadow-blue-700/30 hover:shadow-blue-500/40 focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        Get Emergency Website Check
      </a>
      <a
        href="https://wa.me/919998757045?text=My%20WordPress%20website%20is%20hacked%2C%20I%20need%20emergency%20help."
        target="_blank"
        rel="noopener noreferrer"
        onclick="window.trackWhatsAppClick?.()"
        class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-200 shadow-lg shadow-green-700/30 hover:shadow-green-500/40 focus-visible:ring-2 focus-visible:ring-green-400"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now — Fastest Response
      </a>
    </div>

    <!-- Pricing anchor — visible before any scroll -->
    <div class="inline-flex flex-wrap justify-center items-center gap-2 mb-6 bg-white/5 border border-white/10 rounded-2xl px-5 py-3 text-sm" data-reveal data-delay="450">
      <span class="text-green-400 font-bold text-base">From ₹14,999</span>
      <span class="text-slate-500 hidden sm:inline">·</span>
      <span class="text-slate-300">Fixed quote before work begins</span>
      <span class="text-slate-500 hidden sm:inline">·</span>
      <span class="text-slate-300">No fix = no charge</span>
      <span class="text-slate-500 hidden sm:inline">·</span>
      <span class="text-slate-300">Same-day emergency available</span>
    </div>

    <!-- Reassurance pills -->
    <div class="flex flex-wrap justify-center gap-3 text-sm text-slate-400" data-reveal data-delay="500">
      {[
        'Free initial diagnosis',
        '30-day reinfection guarantee',
        'Backup before any changes',
        'India-focused emergency support',
      ].map((item) => (
        <span class="flex items-center gap-1.5 bg-white/5 border border-white/10 rounded-full px-3 py-1">
          <svg class="w-3.5 h-3.5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
          {item}
        </span>
      ))}
    </div>

  </div>
</section>

---
---
<nav
  id="main-nav"
  class="bg-slate-950/95 backdrop-blur-md border-b border-slate-800/60 px-4 py-3 sticky top-0 z-50 transition-shadow duration-300"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="bg-red-600 rounded-md px-2 py-0.5">
        <span class="text-white text-xs font-bold tracking-wider">EMERGENCY</span>
      </div>
      <a href="#top" class="flex items-center gap-2 text-white font-bold text-sm hover:text-blue-400 transition-colors duration-200">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white shadow-lg shadow-blue-900/30">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3l7 3v5c0 4.8-2.9 8.6-7 10-4.1-1.4-7-5.2-7-10V6l7-3z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-5" />
          </svg>
        </span>
        <span>HackedWebsiteRecovery<span class="text-blue-400">.in</span></span>
      </a>
      <span class="hidden lg:flex items-center gap-2 border-l border-slate-700 pl-3 text-slate-400 text-xs">
        by
        <img src="/brand/webadish-logo-white.png" alt="WebAdish LLP" class="h-11 w-auto" />
      </span>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/wordpress-security-scanner/"
        class="hidden md:inline-flex items-center gap-1.5 text-slate-300 hover:text-white text-sm font-medium transition-colors duration-200"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        Free Scan
      </a>
      <a
        href="tel:+919998757045"
        onclick="window.trackPhoneClick?.()"
        class="hidden md:flex items-center gap-1.5 text-slate-300 hover:text-white text-sm font-medium transition-colors duration-200"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z" />
        </svg>
        +91 99987 57045
      </a>
      <a
        href="https://wa.me/919998757045?text=My%20WordPress%20website%20is%20hacked%2C%20I%20need%20emergency%20help."
        target="_blank"
        rel="noopener noreferrer"
        onclick="window.trackWhatsAppClick?.()"
        class="bg-green-500 hover:bg-green-600 text-white text-sm font-bold px-4 py-2 rounded-lg transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-green-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
      >
        WhatsApp Now
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('shadow-lg', window.scrollY > 20);
  }, { passive: true });
</script>

---
// Mid-page nudge to the free scanner — captures visitors who aren't ready to
// book a recovery yet but will run a free check (email = the lead).
---
<section class="py-16 px-4 bg-white">
  <div class="max-w-4xl mx-auto">
    <div class="rounded-3xl bg-gradient-to-br from-slate-900 to-blue-900 p-8 sm:p-10 text-center text-white relative overflow-hidden">
      <div class="absolute -top-16 -left-16 w-56 h-56 bg-blue-500/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white/10 border border-white/15 mb-5">
          <svg class="w-7 h-7 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold mb-3">Not sure if your site is actually hacked?</h2>
        <p class="text-blue-100 max-w-xl mx-auto mb-7 leading-relaxed">
          Run a free instant security scan — check for malware, Google blacklisting, spam injections, and security gaps in seconds. No signup needed to see your result.
        </p>
        <a
          href="/wordpress-security-scanner/"
          class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-8 rounded-xl text-base transition-all duration-200 shadow-lg shadow-blue-900/40 focus-visible:ring-2 focus-visible:ring-blue-400"
        >
          Scan My Site Free
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

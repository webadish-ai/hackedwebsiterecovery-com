---
---
<section class="py-20 px-4 bg-blue-700 text-white" id="contact">
  <div class="max-w-4xl mx-auto">

    <div class="text-center mb-12" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">Get Emergency Help Now</h2>
      <p class="text-blue-100 max-w-xl mx-auto">Send us your details and we will assess your situation and send you a quote — usually within a few hours. WhatsApp is the fastest route.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-10 items-start">

      <!-- Contact options -->
      <div class="space-y-4" data-reveal>
        <a
          href="https://wa.me/919998757045?text=My%20WordPress%20website%20is%20hacked%2C%20I%20need%20emergency%20help."
          target="_blank"
          rel="noopener noreferrer"
          onclick="window.trackWhatsAppClick?.()"
          class="flex items-center gap-4 bg-green-600 hover:bg-green-500 rounded-2xl px-6 py-5 transition-all duration-200 group focus-visible:ring-2 focus-visible:ring-white"
        >
          <div class="flex-shrink-0 bg-green-500 group-hover:bg-green-400 rounded-xl p-3 transition-colors duration-200">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <div class="font-bold text-white">WhatsApp — Fastest Response</div>
            <div class="text-green-200 text-sm">+91 99987 57045 · Usually replies in minutes</div>
          </div>
        </a>

        <a
          href="mailto:help@wordpressrecovery.in"
          class="flex items-center gap-4 bg-white/10 hover:bg-white/20 rounded-2xl px-6 py-5 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-white"
        >
          <div class="flex-shrink-0 bg-white/10 rounded-xl p-3">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <div class="font-bold text-white">Email</div>
            <div class="text-blue-200 text-sm">help@wordpressrecovery.in</div>
          </div>
        </a>

        <a
          href="tel:+919998757045"
          onclick="window.trackPhoneClick?.()"
          class="flex items-center gap-4 bg-white/10 hover:bg-white/20 rounded-2xl px-6 py-5 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-white"
        >
          <div class="flex-shrink-0 bg-white/10 rounded-xl p-3">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
            </svg>
          </div>
          <div>
            <div class="font-bold text-white">Call (India)</div>
            <div class="text-blue-200 text-sm">+91 99987 57045 · Business hours IST</div>
          </div>
        </a>

        <div class="bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-sm text-blue-100">
          <strong class="text-white">Include:</strong> your website URL, what you are seeing, and your hosting provider. This speeds up the diagnosis.
        </div>
      </div>

      <!-- Contact form -->
      <div class="bg-white rounded-2xl p-8 text-slate-900" data-reveal data-delay="100">
        <h3 class="font-bold text-xl mb-5">Send a Quick Message</h3>
        <form id="contact-form" class="space-y-4" novalidate>
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Your name</label>
            <input
              type="text" id="name" name="name" required autocomplete="name"
              placeholder="Rajesh Sharma"
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:border-blue-500 outline-none transition-all duration-150"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
            <input
              type="email" id="email" name="email" required autocomplete="email"
              placeholder="you@yourbusiness.com"
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:border-blue-500 outline-none transition-all duration-150"
            />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">WhatsApp / Phone <span class="text-gray-400 font-normal">(recommended)</span></label>
            <input
              type="tel" id="phone" name="phone" autocomplete="tel"
              placeholder="+91 99999 99999"
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:border-blue-500 outline-none transition-all duration-150"
            />
          </div>
          <div>
            <label for="website" class="block text-sm font-medium text-gray-700 mb-1">Website URL</label>
            <input
              type="url" id="website" name="website"
              placeholder="https://yourbusiness.com"
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:border-blue-500 outline-none transition-all duration-150"
            />
          </div>
          <div>
            <label for="problem" class="block text-sm font-medium text-gray-700 mb-1">What are you seeing?</label>
            <textarea
              id="problem" name="problem" required rows={3}
              placeholder="My site is redirecting to casino pages, and Google is showing a warning..."
              class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:border-blue-500 outline-none transition-all duration-150 resize-none"
            ></textarea>
          </div>

          <!-- Status messages -->
          <div id="form-success" class="hidden bg-green-50 border border-green-200 text-green-800 text-sm rounded-xl px-4 py-3">
            Message sent. We will be in touch within a few hours.
          </div>
          <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl px-4 py-3">
            Something went wrong. Please try WhatsApp or email instead.
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-blue-600 hover:bg-blue-700 disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold py-3 px-6 rounded-xl transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2"
          >
            Send Emergency Request
          </button>
          <p class="text-xs text-gray-400 text-center">We typically respond within 2–4 hours during business hours.</p>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const success = document.getElementById('form-success')!;
  const error = document.getElementById('form-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Sending…';
    success.classList.add('hidden');
    error.classList.add('hidden');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: (form.elements.namedItem('name') as HTMLInputElement).value,
          email: (form.elements.namedItem('email') as HTMLInputElement).value,
          phone: (form.elements.namedItem('phone') as HTMLInputElement).value,
          website: (form.elements.namedItem('website') as HTMLInputElement).value,
          problem: (form.elements.namedItem('problem') as HTMLTextAreaElement).value,
        }),
      });
      if (res.ok) {
        window.location.href = '/thank-you';
      } else {
        throw new Error('non-ok');
      }
    } catch {
      error.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Emergency Request';
    }
  });
</script>

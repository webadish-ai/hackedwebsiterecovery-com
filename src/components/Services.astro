---
const services = [
  {
    title: 'WordPress Malware Removal',
    desc: 'Manual extraction of infected files, backdoors, obfuscated code, and malicious database injections. Complete file and DB scan.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>`,
    featured: false,
    href: '/wordpress-malware-removal-india/',
  },
  {
    title: 'Hacked WordPress Recovery',
    desc: 'Full site restoration including core reinstall, plugin/theme audit, database cleanup, and admin access recovery.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>`,
    featured: false,
  },
  {
    title: 'Google Blacklist Removal',
    desc: 'Remove your site from Google Safe Browsing, McAfee, Norton, and hosting blacklists. Reconsideration requests handled.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
    featured: false,
    href: '/google-blacklist-removal-india/',
  },
  {
    title: 'Redirect Virus Removal',
    desc: 'Eliminate .htaccess, JavaScript, and database-level redirects sending visitors to spam, pharma, casino, or competitor sites.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>`,
    featured: false,
    href: '/wordpress-redirect-virus-removal-india/',
  },
  {
    title: 'Hosting Suspension Recovery',
    desc: 'Clean malware to satisfy host requirements. Works with SiteGround, Hostinger, GoDaddy, Bluehost, and cPanel hosts.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>`,
    featured: false,
    href: '/hosting-account-suspended-malware-india/',
  },
  {
    title: 'White Screen & Critical Error Fix',
    desc: 'Diagnose and fix fatal PHP errors, plugin conflicts, memory limit issues, and corrupted core causing blank screens.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
    featured: false,
  },
  {
    title: 'Backup Restore & Recovery',
    desc: 'Restore from clean backup and verify integrity. If no backup exists, reconstruct from hosting snapshots or partial files.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>`,
    featured: false,
  },
  {
    title: 'Monthly WordPress Protection',
    desc: 'Ongoing monitoring, security scanning, daily backups, update management, and uptime alerts. Stop the next hack before it happens.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>`,
    featured: true,
  },
];
---
<section class="py-20 px-4 bg-white" id="services">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-14" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">WordPress Recovery & Security Services</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">Every service is handled by specialists — not automated scanners. We diagnose, clean, harden, and hand back a secure site with full documentation.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {services.map((s, i) => (
        <div
          class={`rounded-2xl p-6 transition-all duration-200 cursor-default ${
            s.featured
              ? 'bg-blue-700 border-2 border-blue-500 shadow-xl shadow-blue-900/20'
              : 'bg-slate-50 border border-slate-200 hover:border-blue-200 hover:shadow-md'
          }`}
          data-reveal
          data-delay={String(Math.min((i % 4) * 100, 300))}
        >
          <div class={`rounded-xl w-12 h-12 flex items-center justify-center mb-4 ${s.featured ? 'bg-blue-600' : 'bg-blue-100'}`}>
            <svg class={`w-6 h-6 ${s.featured ? 'text-white' : 'text-blue-700'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <Fragment set:html={s.icon} />
            </svg>
          </div>
          <h3 class={`font-bold mb-2 text-[15px] leading-snug ${s.featured ? 'text-white' : 'text-slate-900'}`}>{s.title}</h3>
          <p class={`text-sm leading-relaxed ${s.featured ? 'text-blue-100' : 'text-gray-600'}`}>{s.desc}</p>
          {s.href && (
            <a href={s.href} class="inline-flex items-center gap-1 mt-3 text-sm font-semibold text-blue-600 hover:gap-2 transition-all">
              Learn more
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          )}
          {s.featured && (
            <span class="inline-block mt-3 bg-blue-600 text-blue-100 text-xs font-semibold px-3 py-1 rounded-full">Most Popular</span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

# Same Resend API key used by autosheets-license-server.
# webadish.com domain is already verified — no extra DNS setup needed.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: enables the live Google Safe Browsing blacklist check in the
# /wordpress-security-scanner. Create a key in Google Cloud (Safe Browsing API).
# If unset, the scanner still runs all other checks and shows blacklist as "N/A".
SAFE_BROWSING_API_KEY=

# Supabase development adapter configuration. Leave blank to use the in-memory
# workflow fixtures; never place service-role keys in browser-exposed variables.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-development-anon-key
SUPABASE_ANON_KEY=your-development-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder
SUPABASE_REPORTS_BUCKET=case-reports
STAFF_MFA_MAX_AGE_MINUTES=15

# Keep false outside isolated local/test fixture runs. Development auth,
# headers, sessions, and in-memory case APIs are unavailable in production.
ENABLE_DEVELOPMENT_WORKFLOW=false
